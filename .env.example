# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
PAGE_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
PAGE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
PAGE_DEEPSEEK_API_KEY=
PAGE_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
PAGE_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
PAGE_OPENAI_API_BASE=https://www.right.codes/codex/v1
PAGE_OPENAI_API_KEY=
PAGE_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse PAGE_RIGHT_CODES_API_KEY when your gateway shares one key.
PAGE_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
PAGE_ANTHROPIC_API_KEY=
PAGE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
PAGE_SECRET_ENV_NAMES=
